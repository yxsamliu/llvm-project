    ; CHECK-NEXT: BUNDLE implicit-def $stg_dsta, implicit [[S_LSHL_B32_]], implicit $exec, implicit $idx1 :: (store (s32), addrspace 10) {
    ; CHECK-NEXT:   $stg_dsta = V_MAX_U32_e64 12345, [[S_LSHL_B32_]], implicit $exec
    ; CHECK-NEXT:   V_STORE_IDX_B32 internal $stg_dsta, $idx1, 0, implicit $exec :: (store (s32), addrspace 10)
    ; CHECK-NEXT: }
    %0:sreg_32_xexec_hi = S_LSHL_B32 1, 2, implicit-def $scc
    %1:vgpr_32 = V_MAX_U32_e64 12345, %0:sreg_32_xexec_hi, implicit $exec
    V_STORE_IDX_B32 %1:vgpr_32, %0:sreg_32_xexec_hi, 0, implicit $exec :: (store (s32), addrspace 10)
