# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -run-pass=greedy,amdgpu-rewrite-agpr-copy-mfma -verify-machineinstrs -o - %s | FileCheck %s

# Keep AGPR0 and AGPR1 live so greedy assigns the loaded value to AGPR2.
# The MFMA rewrite must still run when AGPR0 has no assigned live interval.
---
name: test_rewrite_nonzero_agpr_allocation
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr5, $agpr0_agpr1

    %0:vreg_64_align2 = COPY $vgpr4_vgpr5
    %1:av_64_align2 = COPY $vgpr0_vgpr1
    %2:av_64_align2 = COPY $vgpr2_vgpr3
    %3:areg_128_align2 = GLOBAL_LOAD_DWORDX4 %0, 0, 0, implicit $exec :: (load (s128), addrspace 1)
    %4:vreg_128_align2 = COPY %3
    %5:vreg_64_align2 = V_MFMA_F64_4X4X4F64_vgprcd_e64 %1, %2, %4.sub0_sub1, 0, 0, 0, implicit $mode, implicit $exec
    GLOBAL_STORE_DWORDX2 %0, %5, 0, 0, implicit $exec :: (store (s64), addrspace 1)
    INLINEASM &"; hold AGPR0", sideeffect attdialect, reguse:AReg_64_Align2, $agpr0_agpr1
    SI_RETURN
...

# CHECK-LABEL: name:{{ *}}test_rewrite_nonzero_agpr_allocation
# CHECK: assigned-phys: '$agpr2_agpr3_agpr4_agpr5'
# CHECK: V_MFMA_F64_4X4X4F64_e64
