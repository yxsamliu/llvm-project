  ; GCN: bb.0:
  ; GCN-NEXT:   successors: %bb.1(0x80000000)
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[S_LSHL_B32_:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 1, 2, implicit-def dead $scc
  ; GCN-NEXT:   S_CMP_EQ_U32 [[S_LSHL_B32_]], 0, implicit-def dead $scc
  ; GCN-NEXT:   [[S_LSHL_B32_1:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 [[S_LSHL_B32_]], 2, implicit-def dead $scc
  ; GCN-NEXT:   [[S_LSHL_B32_2:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 [[S_LSHL_B32_1]], 1, implicit-def dead $scc
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.1:
  ; GCN-NEXT:   successors: %bb.2(0x80000000)
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT:   [[S_LSHL_B32_3:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 [[S_LSHL_B32_2]], 1, implicit-def dead $scc
  ; GCN-NEXT: {{  $}}
  ; GCN-NEXT: bb.2:
  ; GCN-NEXT:   BUNDLE implicit-def $stg_srca, implicit-def %4, implicit [[S_LSHL_B32_]], implicit $exec, implicit [[S_LSHL_B32_2]] :: (load (s32), addrspace 10) {
  ; GCN-NEXT:     $stg_srca = V_LOAD_IDX_B32 [[S_LSHL_B32_]], 0, implicit $exec :: (load (s32), addrspace 10)
  ; GCN-NEXT:     [[V_MAX_U32_e64_:%[0-9]+]]:vgpr_32 = V_MAX_U32_e64 internal $stg_srca, [[S_LSHL_B32_2]], implicit $exec
  ; GCN-NEXT:   }
  ; GCN-NEXT:   BUNDLE implicit-def $stg_srca, implicit-def %6, implicit [[S_LSHL_B32_]], implicit $exec :: (load (s32), addrspace 10) {
  ; GCN-NEXT:     $stg_srca = V_LOAD_IDX_B32 [[S_LSHL_B32_]], 0, implicit $exec :: (load (s32), addrspace 10)
  ; GCN-NEXT:     [[V_READFIRSTLANE_B32_:%[0-9]+]]:sreg_32_xm0 = V_READFIRSTLANE_B32 internal $stg_srca, implicit $exec
  ; GCN-NEXT:   }
  ; GCN-NEXT:   [[S_LSHL_B32_4:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 [[S_LSHL_B32_3]], [[V_READFIRSTLANE_B32_]], implicit-def dead $scc
  ; GCN-NEXT:   V_STORE_IDX_B32 [[V_MAX_U32_e64_]], [[S_LSHL_B32_4]], 0, implicit $exec :: (store (s32), addrspace 10)
  ;
  ; ALLOC-LABEL: name: multi-bb-coremis-swap-order
  ; ALLOC: bb.0:
  ; ALLOC-NEXT:   successors: %bb.1(0x80000000)
  ; ALLOC-NEXT: {{  $}}
  ; ALLOC-NEXT:   [[S_LSHL_B32_:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 1, 2, implicit-def dead $scc
  ; ALLOC-NEXT:   [[S_LSHL_B32_1:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 [[S_LSHL_B32_]], 2, implicit-def dead $scc
  ; ALLOC-NEXT:   [[S_LSHL_B32_2:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 [[S_LSHL_B32_1]], 1, implicit-def dead $scc
  ; ALLOC-NEXT: {{  $}}
  ; ALLOC-NEXT: bb.1:
  ; ALLOC-NEXT:   successors: %bb.2(0x80000000)
  ; ALLOC-NEXT: {{  $}}
  ; ALLOC-NEXT:   [[S_LSHL_B32_3:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 [[S_LSHL_B32_2]], 1, implicit-def dead $scc
  ; ALLOC-NEXT: {{  $}}
  ; ALLOC-NEXT: bb.2:
  ; ALLOC-NEXT:   $idx1 = S_SET_GPR_IDX_U32 [[S_LSHL_B32_]]
  ; ALLOC-NEXT:   BUNDLE implicit-def $stg_srca, implicit-def %4, implicit $idx1, implicit $exec, implicit [[S_LSHL_B32_2]] :: (load (s32), addrspace 10) {
  ; ALLOC-NEXT:     $stg_srca = V_LOAD_IDX_B32 $idx1, 0, implicit $exec :: (load (s32), addrspace 10)
  ; ALLOC-NEXT:     [[V_MAX_U32_e64_:%[0-9]+]]:vgpr_32 = V_MAX_U32_e64 internal $stg_srca, [[S_LSHL_B32_2]], implicit $exec
  ; ALLOC-NEXT:   }
  ; ALLOC-NEXT:   BUNDLE implicit-def $stg_srca, implicit-def %6, implicit $idx1, implicit $exec :: (load (s32), addrspace 10) {
  ; ALLOC-NEXT:     $stg_srca = V_LOAD_IDX_B32 $idx1, 0, implicit $exec :: (load (s32), addrspace 10)
  ; ALLOC-NEXT:     [[V_READFIRSTLANE_B32_:%[0-9]+]]:sreg_32_xm0 = V_READFIRSTLANE_B32 internal $stg_srca, implicit $exec
  ; ALLOC-NEXT:   }
  ; ALLOC-NEXT:   [[S_LSHL_B32_4:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 [[S_LSHL_B32_3]], [[V_READFIRSTLANE_B32_]], implicit-def dead $scc
  ; ALLOC-NEXT:   $idx1 = S_SET_GPR_IDX_U32 [[S_LSHL_B32_4]]
  ; ALLOC-NEXT:   V_STORE_IDX_B32 [[V_MAX_U32_e64_]], $idx1, 0, implicit $exec :: (store (s32), addrspace 10)
  ;
  ; LOWERED-LABEL: name: multi-bb-coremis-swap-order
  ; LOWERED: bb.0:
  ; LOWERED-NEXT:   frame-setup CFI_INSTRUCTION escape 0x0f, 0x09, 0x90, 0x40, 0x94, 0x04, 0x35, 0x24, 0x36, 0xe9, 0x02
  ; LOWERED-NEXT:   frame-setup CFI_INSTRUCTION llvm_register_pair $pc_reg, $sgpr30, 32, $sgpr31, 32
  ; LOWERED-NEXT:   frame-setup CFI_INSTRUCTION undefined $vgpr0
  ; LOWERED-NEXT:   frame-setup CFI_INSTRUCTION undefined $sgpr0
  ; LOWERED-NEXT:   frame-setup CFI_INSTRUCTION undefined $sgpr1
  ; LOWERED-NEXT:   frame-setup CFI_INSTRUCTION undefined $sgpr2
  ; LOWERED-NEXT:   S_WAIT_LOADCNT_DSCNT 0
  ; LOWERED-NEXT:   S_WAIT_EXPCNT 0
  ; LOWERED-NEXT:   S_WAIT_SAMPLECNT 0
  ; LOWERED-NEXT:   S_WAIT_BVHCNT 0
  ; LOWERED-NEXT:   S_WAIT_KMCNT 0
  ; LOWERED-NEXT:   renamable $sgpr1 = S_LSHL_B32 1, 2, implicit-def dead $scc
  ; LOWERED-NEXT:   $idx1 = S_SET_GPR_IDX_U32 renamable $sgpr1
  ; LOWERED-NEXT:   renamable $sgpr0 = S_LSHL_B32 killed renamable $sgpr1, 2, implicit-def dead $scc
  ; LOWERED-NEXT:   S_SET_VGPR_FRAMES 1
  ; LOWERED-NEXT:   renamable $sgpr1 = V_READFIRSTLANE_B32 undef $vgpr0, <0x{{[0-9a-f]+}}>, implicit $exec
  ; LOWERED-NEXT:   renamable $sgpr0 = S_LSHL_B32 killed renamable $sgpr0, 1, implicit-def dead $scc
  ; LOWERED-NEXT:   renamable $vgpr0 = V_MAX_U32_e64 undef $vgpr0, $sgpr0, <0x{{[0-9a-f]+}}>, implicit $exec
  ; LOWERED-NEXT:   renamable $sgpr2 = S_LSHL_B32 killed renamable $sgpr0, 1, implicit-def dead $scc
  ; LOWERED-NEXT:   renamable $sgpr1 = S_LSHL_B32 killed renamable $sgpr2, killed renamable $sgpr1, implicit-def dead $scc
  ; LOWERED-NEXT:   $idx1 = S_SET_GPR_IDX_U32 killed renamable $sgpr1
  ; LOWERED-NEXT:   S_SET_VGPR_FRAMES 64
  ; LOWERED-NEXT:   $vgpr0 = V_MOV_B32_e32 $vgpr0, <0x{{[0-9a-f]+}}>, implicit $exec
  ; LOWERED-NEXT:   S_SET_VGPR_FRAMES 0

  bb.0:
    %0:sreg_32_xexec_hi = S_LSHL_B32 1, 2, implicit-def dead $scc
    %1:vgpr_32 = V_LOAD_IDX_B32 %0:sreg_32_xexec_hi, 0, implicit $exec :: (load (s32), addrspace 10)
    S_CMP_EQ_U32 %0:sreg_32_xexec_hi, 0, implicit-def dead $scc
    %2:sreg_32_xexec_hi = S_LSHL_B32 %0:sreg_32_xexec_hi, 2, implicit-def dead $scc
    %3:sreg_32_xexec_hi = S_LSHL_B32 %2:sreg_32_xexec_hi, 1, implicit-def dead $scc

  bb.1:
    %4:vgpr_32 = V_MAX_U32_e64 %1:vgpr_32, %3:sreg_32_xexec_hi, implicit $exec
    %5:sreg_32_xexec_hi = S_LSHL_B32 %3:sreg_32_xexec_hi, 1, implicit-def dead $scc

  bb.2:
    %6:sreg_32_xm0 = V_READFIRSTLANE_B32 %1:vgpr_32, implicit $exec
    %7:sreg_32_xexec_hi = S_LSHL_B32 %5:sreg_32_xexec_hi, %6:sreg_32_xm0, implicit-def dead $scc
    V_STORE_IDX_B32 %4:vgpr_32, %7:sreg_32_xexec_hi, 0, implicit $exec :: (store (s32), addrspace 10)
