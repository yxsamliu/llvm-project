# Bundling would introduce impossible cycles in the dataflow.
---
name:            same-bb-store-cannot-bundle-indirect
machineFunctionInfo:
  laneSharedVGPRSize: 1000
  stackPtrOffsetReg: '$sgpr32'
  frameOffsetReg: '$sgpr33'
tracksRegLiveness: true
body:             |

  bb.0:
    ; GCN-LABEL: name: same-bb-store-cannot-bundle-indirect
    ; GCN: [[S_LSHL_B32_:%[0-9]+]]:sreg_32_xexec_hi = S_LSHL_B32 1, 2, implicit-def $scc
    ; GCN-NEXT: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; GCN-NEXT: [[DS_READ_B32_gfx9_:%[0-9]+]]:vgpr_32 = DS_READ_B32_gfx9 [[DEF]], 0, 0, implicit $exec :: (load (s32), addrspace 3)
    ; GCN-NEXT: [[V_READFIRSTLANE_B32_:%[0-9]+]]:sgpr_32 = V_READFIRSTLANE_B32 [[DS_READ_B32_gfx9_]], implicit $exec
    ; GCN-NEXT: V_STORE_IDX_B32 [[DS_READ_B32_gfx9_]], [[V_READFIRSTLANE_B32_]], 0, implicit $exec :: (store (s32), addrspace 10)
    ;
    ; ALLOC-LABEL: name: same-bb-store-cannot-bundle-indirect
    ; ALLOC: [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
    ; ALLOC-NEXT: [[DS_READ_B32_gfx9_:%[0-9]+]]:vgpr_32 = DS_READ_B32_gfx9 [[DEF]], 0, 0, implicit $exec :: (load (s32), addrspace 3)
    ; ALLOC-NEXT: [[V_READFIRSTLANE_B32_:%[0-9]+]]:sgpr_32 = V_READFIRSTLANE_B32 [[DS_READ_B32_gfx9_]], implicit $exec
    ; ALLOC-NEXT: $idx1 = S_SET_GPR_IDX_U32 [[V_READFIRSTLANE_B32_]]
    ; ALLOC-NEXT: V_STORE_IDX_B32 [[DS_READ_B32_gfx9_]], $idx1, 0, implicit $exec :: (store (s32), addrspace 10)
    ;
    ; LOWERED-LABEL: name: same-bb-store-cannot-bundle-indirect
    ; LOWERED: frame-setup CFI_INSTRUCTION escape 0x0f, 0x09, 0x90, 0x40, 0x94, 0x04, 0x35, 0x24, 0x36, 0xe9, 0x02
    ; LOWERED-NEXT: frame-setup CFI_INSTRUCTION llvm_register_pair $pc_reg, $sgpr30, 32, $sgpr31, 32
    ; LOWERED-NEXT: frame-setup CFI_INSTRUCTION undefined $vgpr0
    ; LOWERED-NEXT: frame-setup CFI_INSTRUCTION undefined $sgpr0
    ; LOWERED-NEXT: S_WAIT_LOADCNT_DSCNT 0
    ; LOWERED-NEXT: S_WAIT_EXPCNT 0
    ; LOWERED-NEXT: S_WAIT_SAMPLECNT 0
    ; LOWERED-NEXT: S_WAIT_BVHCNT 0
    ; LOWERED-NEXT: S_WAIT_KMCNT 0
    ; LOWERED-NEXT: renamable $vgpr0 = DS_READ_B32_gfx9 undef renamable $vgpr0, 0, 0, implicit $exec :: (load (s32), addrspace 3)
    ; LOWERED-NEXT: S_WAIT_DSCNT 0
    ; LOWERED-NEXT: renamable $sgpr0 = V_READFIRSTLANE_B32 $vgpr0, implicit $exec
    ; LOWERED-NEXT: $idx1 = S_SET_GPR_IDX_U32 killed renamable $sgpr0
    ; LOWERED-NEXT: S_SET_VGPR_FRAMES 64
    ; LOWERED-NEXT: $vgpr0 = V_MOV_B32_e32 $vgpr0, <0x{{[0-9a-f]+}}>, implicit $exec
    ; LOWERED-NEXT: S_SET_VGPR_FRAMES 0
    %0:sreg_32_xexec_hi = S_LSHL_B32 1, 2, implicit-def $scc
    %1:vgpr_32 = IMPLICIT_DEF
    %2:vgpr_32 = DS_READ_B32_gfx9 %1, 0, 0, implicit $exec :: (load (s32), addrspace 3)
    %3:sgpr_32 = V_READFIRSTLANE_B32 %2, implicit $exec
    V_STORE_IDX_B32 %2:vgpr_32, %3, 0, implicit $exec :: (store (s32), addrspace 10)
...

