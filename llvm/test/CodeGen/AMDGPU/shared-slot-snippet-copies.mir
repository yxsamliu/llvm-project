# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=regallocbasic -stress-regalloc=4 -experimental-native-partial-spill -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=regallocbasic -stress-regalloc=4 -experimental-partial-spill-rmw -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s

# The spill group contains two snippets connected by another copy. Copies of
# matching words are storage identities; a copy that changes word positions
# must still read and update the shared slot.

# CHECK-LABEL: name: snippet_low
# CHECK: SI_SPILL_S64_SAVE
# CHECK-NOT: SI_SPILL_S{{[0-9]+}}_SAVE
# CHECK: SI_SPILL_S64_RESTORE
# CHECK-NOT: SI_SPILL_S{{[0-9]+}}_SAVE
# CHECK-NOT: SI_SPILL_S64_RESTORE
# CHECK: S_ENDPGM

---
name: snippet_low
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: sreg_64, preferred-register: '$sgpr4_sgpr5' }
  - { id: 1, class: sreg_64, split-from: '%0' }
  - { id: 2, class: sreg_64, split-from: '%0' }
  - { id: 3, class: sreg_64, split-from: '%0' }
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    %0:sreg_64 = COPY $sgpr0_sgpr1
    %1:sreg_64 = lr-split COPY %0
    %2:sreg_64 = lr-split COPY %1
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL implicit-def dead $sgpr0, implicit-def dead $sgpr1, implicit-def dead $sgpr2, implicit-def dead $sgpr3, implicit-def dead $sgpr6, implicit-def dead $sgpr7
    undef %3.sub0:sreg_64 = lr-split COPY %2.sub0
    %1.sub0:sreg_64 = lr-split COPY %3.sub0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL %0
    KILL implicit-def dead $sgpr0, implicit-def dead $sgpr1, implicit-def dead $sgpr2, implicit-def dead $sgpr3, implicit-def dead $sgpr6, implicit-def dead $sgpr7
    %4:sreg_32 = S_ADD_U32 %1.sub0, %1.sub1, implicit-def dead $scc
    $sgpr0 = COPY %4
    KILL %0
    S_ENDPGM 0
...

# CHECK-LABEL: name: snippet_high
# CHECK: SI_SPILL_S64_SAVE
# CHECK-NOT: SI_SPILL_S{{[0-9]+}}_SAVE
# CHECK: SI_SPILL_S64_RESTORE
