# CHECK-LABEL: name: snippet_swap
# CHECK: SI_SPILL_S64_SAVE
# CHECK: SI_SPILL_S64_RESTORE
# CHECK: COPY {{.*}}.sub1
# CHECK: SI_SPILL_S{{(32_SAVE_partial|64_SAVE)}}
# CHECK: SI_SPILL_S64_RESTORE
# CHECK: S_ENDPGM

