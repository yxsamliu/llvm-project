# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -verify-machineinstrs -stress-regalloc=1 -run-pass=greedy,virtregrewriter,stack-slot-coloring -no-stack-slot-sharing -wave-guided-spill-placement=false -wave-guided-spill-costs=false -amdgpu-wave-guided-stack-slot-coloring %s -o - | FileCheck %s --check-prefix=WAVE
