--- |
  target triple = "amdgcn-amd-amdhsa"
  define void @wave_coloring(i1 %cond) !wave.profile !0 {
  entry:
    br i1 %cond, label %left, label %right, !wave.profile.block !1
  left:
    br label %exit, !wave.profile.block !2
  right:
    br label %exit, !wave.profile.block !3
  exit:
    ret void, !wave.profile.block !4
  }
  !0 = distinct !{i64 2, i64 18032034528222026113, i64 100, i64 90, i64 100, i64 100}
  !1 = !{i64 2, i64 18032034528222026113, i64 0, i64 1, i64 1, i64 2}
  !2 = !{i64 2, i64 18032034528222026113, i64 1, i64 1, i64 3}
  !3 = !{i64 2, i64 18032034528222026113, i64 2, i64 1, i64 3}
  !4 = !{i64 2, i64 18032034528222026113, i64 3, i64 1}
...
