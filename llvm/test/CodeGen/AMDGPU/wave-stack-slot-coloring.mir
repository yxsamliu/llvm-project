# REQUIRES: amdgpu-registered-target
# Keep the earlier allocator costs fixed. Disabling sharing exposes the slot
# priority order without changing which intervals may share storage.
# The right arm has fewer lane visits but more measured wave visits.
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -verify-machineinstrs -stress-regalloc=1 -run-pass=greedy,virtregrewriter,stack-slot-coloring -no-stack-slot-sharing -wave-guided-spill-placement=false -wave-guided-spill-costs=false %s -o - | FileCheck %s --check-prefix=WAVE
