    ; CHECK-NEXT:   $stg_dsta, $stg_dstb = V_SEND_VGPR_NEXT_B32 renamable $vgpr0, 0, 0, 0, 0, 15, implicit $mode, implicit $exec
    ; CHECK-NEXT:   V_STORE_IDX_B32 internal $stg_dsta, $idx1, 2, implicit $exec :: (store (s32) into @laneshared + 8, addrspace 10)
    ; CHECK-NEXT:   V_STORE_IDX_B32 internal $stg_dstb, $idx1, 3, implicit $exec :: (store (s32) into @laneshared + 12, addrspace 10)
