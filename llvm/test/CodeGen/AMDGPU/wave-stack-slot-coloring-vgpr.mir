# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REQUIRES: amdgpu-registered-target
# Wave-derived costs must not reorder ordinary VGPR spill slots.
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -verify-machineinstrs -stress-regalloc=1 -run-pass=greedy,virtregrewriter,stack-slot-coloring -no-stack-slot-sharing -wave-guided-spill-placement=false -wave-guided-spill-costs=false %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -verify-machineinstrs -stress-regalloc=1 -run-pass=greedy,virtregrewriter,stack-slot-coloring -no-stack-slot-sharing -wave-guided-spill-placement=false -wave-guided-spill-costs=false -amdgpu-wave-guided-stack-slot-coloring %s -o - | FileCheck %s

--- |
  target triple = "amdgcn-amd-amdhsa"
  define void @wave_coloring(i1 %cond) !wave.profile !0 {
  entry:
    br i1 %cond, label %left, label %right, !wave.profile.block !1
  left:
    br label %exit, !wave.profile.block !2
  right:
    br label %exit, !wave.profile.block !3
  exit:
    ret void, !wave.profile.block !4
  }
  !0 = distinct !{i64 2, i64 18032034528222026113, i64 100, i64 90, i64 100, i64 100}
  !1 = !{i64 2, i64 18032034528222026113, i64 0, i64 1, i64 1, i64 2}
  !2 = !{i64 2, i64 18032034528222026113, i64 1, i64 1, i64 3}
  !3 = !{i64 2, i64 18032034528222026113, i64 2, i64 1, i64 3}
  !4 = !{i64 2, i64 18032034528222026113, i64 3, i64 1}
...
---
name: wave_coloring
tracksRegLiveness: true
machineFunctionInfo:
  scratchRSrcReg: $sgpr0_sgpr1_sgpr2_sgpr3
  frameOffsetReg: $sgpr4
  stackPtrOffsetReg: $sgpr32
body: |
  ; CHECK-LABEL: name: wave_coloring
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x73333333), %bb.2(0x0ccccccd)
  ; CHECK-NEXT:   liveins: $sgpr8_sgpr9, $vgpr8_vgpr9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_CMP_EQ_U32 $sgpr8, 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.left:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr8_sgpr9, $vgpr8_vgpr9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $vgpr0 = FLAT_LOAD_DWORD $vgpr8_vgpr9, 0, 0, implicit $flat_scr, implicit $exec
  ; CHECK-NEXT:   SI_SPILL_V32_SAVE killed $vgpr0, %stack.1, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.1, addrspace 5)
  ; CHECK-NEXT:   renamable $vgpr0 = FLAT_LOAD_DWORD $vgpr8_vgpr9, 0, 0, implicit $flat_scr, implicit $exec
  ; CHECK-NEXT:   SI_SPILL_V32_SAVE killed $vgpr0, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
  ; CHECK-NEXT:   renamable $vgpr0 = SI_SPILL_V32_RESTORE %stack.1, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.1, addrspace 5)
  ; CHECK-NEXT:   S_NOP 0, implicit killed renamable $vgpr0
  ; CHECK-NEXT:   renamable $vgpr0 = SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
  ; CHECK-NEXT:   S_NOP 0, implicit killed renamable $vgpr0
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.right:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr8_sgpr9, $vgpr8_vgpr9
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   renamable $vgpr0 = FLAT_LOAD_DWORD $vgpr8_vgpr9, 0, 0, implicit $flat_scr, implicit $exec
  ; CHECK-NEXT:   SI_SPILL_V32_SAVE killed $vgpr0, %stack.3, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.3, addrspace 5)
  ; CHECK-NEXT:   renamable $vgpr0 = FLAT_LOAD_DWORD $vgpr8_vgpr9, 0, 0, implicit $flat_scr, implicit $exec
  ; CHECK-NEXT:   SI_SPILL_V32_SAVE killed $vgpr0, %stack.2, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.2, addrspace 5)
  ; CHECK-NEXT:   renamable $vgpr0 = SI_SPILL_V32_RESTORE %stack.3, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.3, addrspace 5)
  ; CHECK-NEXT:   S_NOP 0, implicit killed renamable $vgpr0
  ; CHECK-NEXT:   renamable $vgpr0 = SI_SPILL_V32_RESTORE %stack.2, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.2, addrspace 5)
  ; CHECK-NEXT:   S_NOP 0, implicit killed renamable $vgpr0
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.exit:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0.entry:
    successors: %bb.1(0x73333333), %bb.2(0x0ccccccd)
    liveins: $sgpr8_sgpr9, $vgpr8_vgpr9
    S_CMP_EQ_U32 $sgpr8, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2
  bb.1.left:
    successors: %bb.3(0x80000000)
    liveins: $sgpr8_sgpr9, $vgpr8_vgpr9
    %0:vgpr_32 = FLAT_LOAD_DWORD $vgpr8_vgpr9, 0, 0, implicit $flat_scr, implicit $exec
    %1:vgpr_32 = FLAT_LOAD_DWORD $vgpr8_vgpr9, 0, 0, implicit $flat_scr, implicit $exec
    S_NOP 0, implicit %0
    S_NOP 0, implicit %1
    S_BRANCH %bb.3
  bb.2.right:
    successors: %bb.3(0x80000000)
    liveins: $sgpr8_sgpr9, $vgpr8_vgpr9
    %2:vgpr_32 = FLAT_LOAD_DWORD $vgpr8_vgpr9, 0, 0, implicit $flat_scr, implicit $exec
    %3:vgpr_32 = FLAT_LOAD_DWORD $vgpr8_vgpr9, 0, 0, implicit $flat_scr, implicit $exec
    S_NOP 0, implicit %2
    S_NOP 0, implicit %3
    S_BRANCH %bb.3
  bb.3.exit:
    S_ENDPGM 0
...
