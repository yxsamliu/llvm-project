# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=greedy -stress-regalloc=4 -experimental-native-partial-spill -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=regallocbasic -stress-regalloc=4 -experimental-native-partial-spill -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=greedy -stress-regalloc=4 -experimental-native-partial-spill -experimental-partial-spill-safe-hoisting -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=regallocbasic -stress-regalloc=4 -experimental-native-partial-spill -experimental-partial-spill-safe-hoisting -verify-machineinstrs -verify-regalloc %s -o - | FileCheck %s

# Save only live words in the shared slot, without a preservation reload.
# Sparse bundle definitions must retain their positions in the full slot.
# CHECK-LABEL: name: low_split
# CHECK: SI_SPILL_S64_SAVE {{.*}}, [[LOW:%stack\.[0-9]+]],
# CHECK-NOT: SI_SPILL_S64_RESTORE
# CHECK: SI_SPILL_S32_SAVE_partial {{%[0-9]+}}.sub0, [[LOW]], 0,
# CHECK: SI_SPILL_S64_RESTORE [[LOW]],
# CHECK-LABEL: name: high_split
# CHECK: SI_SPILL_S64_SAVE {{.*}}, [[HIGH:%stack\.[0-9]+]],
# CHECK-NOT: SI_SPILL_S64_RESTORE
# CHECK: SI_SPILL_S32_SAVE_partial {{%[0-9]+}}.sub1, [[HIGH]], 4,
# CHECK: SI_SPILL_S64_RESTORE [[HIGH]],
# CHECK-LABEL: name: sparse_split
# CHECK: SI_SPILL_S128_SAVE {{.*}}, [[SPARSE:%stack\.[0-9]+]],
# CHECK-NOT: SI_SPILL_S128_RESTORE
# CHECK: SI_SPILL_S32_SAVE_partial {{%[0-9]+}}.sub0, [[SPARSE]], 0,
# CHECK-NEXT: SI_SPILL_S32_SAVE_partial {{%[0-9]+}}.sub3, [[SPARSE]], 12,
# CHECK: SI_SPILL_S128_RESTORE [[SPARSE]],


---
name: low_split
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: sreg_64, preferred-register: '$sgpr4_sgpr5' }
  - { id: 1, class: sreg_64, split-from: '%0' }
  - { id: 2, class: sreg_64, split-from: '%0' }
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    %0:sreg_64 = COPY $sgpr0_sgpr1
    %1:sreg_64 = lr-split COPY %0
    KILL implicit-def dead $sgpr0, implicit-def dead $sgpr1, implicit-def dead $sgpr2, implicit-def dead $sgpr3, implicit-def dead $sgpr6, implicit-def dead $sgpr7
    %0.sub0:sreg_64 = S_ADD_U32 %0.sub0, 1, implicit-def dead $scc
    undef %2.sub0:sreg_64 = lr-split COPY %0.sub0
    KILL implicit-def dead $sgpr0, implicit-def dead $sgpr1, implicit-def dead $sgpr2, implicit-def dead $sgpr3, implicit-def dead $sgpr6, implicit-def dead $sgpr7
    %3:sreg_32 = S_ADD_U32 %2.sub0, %1.sub1, implicit-def dead $scc
    $sgpr0 = COPY %3
    KILL %0
    S_ENDPGM 0
...

---
name: high_split
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: sreg_64, preferred-register: '$sgpr4_sgpr5' }
  - { id: 1, class: sreg_64, split-from: '%0' }
  - { id: 2, class: sreg_64, split-from: '%0' }
body: |
  bb.0:
    liveins: $sgpr0_sgpr1
    %0:sreg_64 = COPY $sgpr0_sgpr1
    %1:sreg_64 = lr-split COPY %0
    KILL implicit-def dead $sgpr0, implicit-def dead $sgpr1, implicit-def dead $sgpr2, implicit-def dead $sgpr3, implicit-def dead $sgpr6, implicit-def dead $sgpr7
    %0.sub1:sreg_64 = S_ADD_U32 %0.sub1, 1, implicit-def dead $scc
    $sgpr6 = COPY %0.sub1
    undef %2.sub1:sreg_64 = lr-split COPY $sgpr6
    KILL implicit-def dead $sgpr0, implicit-def dead $sgpr1, implicit-def dead $sgpr2, implicit-def dead $sgpr3, implicit-def dead $sgpr6, implicit-def dead $sgpr7
    %3:sreg_32 = S_ADD_U32 %2.sub1, %1.sub0, implicit-def dead $scc
    $sgpr0 = COPY %3
    KILL %0
    S_ENDPGM 0
...

---
name: sparse_split
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
registers:
  - { id: 0, class: sgpr_128, preferred-register: '$sgpr4_sgpr5_sgpr6_sgpr7' }
  - { id: 1, class: sgpr_128, split-from: '%0' }
  - { id: 2, class: sgpr_128, split-from: '%0' }
body: |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3
    undef %0.sub0:sgpr_128 = COPY $sgpr0 {
      internal %0.sub3:sgpr_128 = COPY $sgpr3
    }
    %1:sgpr_128 = lr-split COPY $sgpr0_sgpr1_sgpr2_sgpr3
    KILL implicit-def dead $sgpr0, implicit-def dead $sgpr1, implicit-def dead $sgpr2, implicit-def dead $sgpr3, implicit-def dead $sgpr8, implicit-def dead $sgpr9, implicit-def dead $sgpr10, implicit-def dead $sgpr11, implicit-def dead $sgpr12, implicit-def dead $sgpr13, implicit-def dead $sgpr14, implicit-def dead $sgpr15
    %0.sub0:sgpr_128 = S_ADD_U32 %0.sub0, 1, implicit-def dead $scc
    undef %2.sub0:sgpr_128 = lr-split COPY %0.sub0 {
      internal %2.sub3:sgpr_128 = lr-split COPY %0.sub3
    }
    KILL implicit-def dead $sgpr0, implicit-def dead $sgpr1, implicit-def dead $sgpr2, implicit-def dead $sgpr3, implicit-def dead $sgpr8, implicit-def dead $sgpr9, implicit-def dead $sgpr10, implicit-def dead $sgpr11, implicit-def dead $sgpr12, implicit-def dead $sgpr13, implicit-def dead $sgpr14, implicit-def dead $sgpr15
    %3:sreg_32 = S_ADD_U32 %2.sub0, %1.sub1, implicit-def dead $scc
    %4:sreg_32 = S_ADD_U32 %3, %2.sub3, implicit-def dead $scc
    $sgpr0 = COPY %4
    KILL %0.sub0, %0.sub3
    S_ENDPGM 0
...
