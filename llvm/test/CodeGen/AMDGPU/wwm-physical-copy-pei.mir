# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -run-pass=liveintervals,virtregmap,si-lower-wwm-copies -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=LOWER
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -run-pass=liveintervals,virtregmap,si-lower-wwm-copies,virtregrewriter,prolog-epilog -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=PEI --implicit-check-not='$vgpr62'

# LOWER-LABEL: name: physical_wwm_copy_pei
# LOWER: wwmReservedRegs:
# LOWER-DAG: - '$agpr0'
# LOWER-DAG: - '$vgpr62'
# LOWER: $agpr0 = COPY $vgpr63
# LOWER: $vgpr62 = COPY $agpr0

# PEI shifts the WWM VGPR down before creating its spill slot. The first two
# objects preserve the final WWM registers; the third is the scavenging slot.
# The implicit check also ensures the old $vgpr62 is not saved or restored.
# PEI-LABEL: name: physical_wwm_copy_pei
# PEI: stackSize: 12
# PEI: stack:
# PEI: - { id: 0, name: '', type: spill-slot
# PEI: - { id: 1, name: '', type: spill-slot
# PEI: - { id: 2, name: '', type: default
# PEI-NOT: - { id: 3,
# PEI: wwmReservedRegs:
# PEI-DAG: - '$agpr0'
# PEI-DAG: - '$vgpr0'
# PEI: scavengeFI: '%stack.2'
# PEI: BUFFER_STORE_DWORD_OFFSET $agpr0
# PEI: BUFFER_STORE_DWORD_OFFSET killed $vgpr0
# PEI: $agpr0 = COPY $vgpr63
# PEI: $vgpr0 = COPY $agpr0
# PEI: $agpr0 = BUFFER_LOAD_DWORD_OFFSET
# PEI: $vgpr0 = BUFFER_LOAD_DWORD_OFFSET

--- |
  define internal void @physical_wwm_copy_pei() {
    ret void
  }
...
---
name: physical_wwm_copy_pei
tracksRegLiveness: true
noVRegs: false
isSSA: false
registers:
  - { id: 0, class: vgpr_32, flags: [ WWM_REG ] }
frameInfo:
  maxAlignment: 4
machineFunctionInfo:
  isEntryFunction: false
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
  stackPtrOffsetReg: '$sgpr32'
  frameOffsetReg: '$sgpr33'
  sgprForEXECCopy: '$sgpr4_sgpr5'
body: |
  bb.0:
    liveins: $vgpr63, $sgpr30_sgpr31
    $agpr0 = WWM_COPY $vgpr63
    $vgpr62 = WWM_COPY $agpr0
    S_SETPC_B64_return $sgpr30_sgpr31
...
