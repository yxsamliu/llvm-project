# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=spill-store-elimination -verify-machineinstrs -o - %s | FileCheck %s --check-prefix=DISABLED
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=spill-store-elimination -enable-spill-store-elimination -verify-machineinstrs -o - %s | FileCheck %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -passes=spill-store-elimination -enable-spill-store-elimination -verify-machineinstrs -o - %s | FileCheck %s

# DISABLED-LABEL: name: partial_redundancy
# DISABLED: bb.1:
# DISABLED: SI_SPILL_V32_RESTORE
# DISABLED: bb.3:
# DISABLED: SI_SPILL_V32_SAVE
# CHECK-LABEL: name: partial_redundancy
# CHECK: bb.1:
# CHECK-NOT: SI_SPILL_V32_RESTORE
# CHECK: bb.2:
# CHECK: SI_SPILL_V32_SAVE
# CHECK: bb.3:
# CHECK-NOT: SI_SPILL_V32_SAVE
# CHECK: SI_SPILL_V32_RESTORE

---
name: partial_redundancy
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 4 }
  - { id: 1, type: spill-slot, size: 8, alignment: 4 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr32, $vgpr0_vgpr1, $vgpr2, $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    liveins: $sgpr32, $vgpr0_vgpr1, $vgpr2
    $vgpr2 = SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)

    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    liveins: $sgpr32, $vgpr0_vgpr1, $vgpr2

    S_BRANCH %bb.3

  bb.3:
    liveins: $sgpr32, $vgpr0_vgpr1, $vgpr2
    SI_SPILL_V32_SAVE killed $vgpr2, %stack.0, $sgpr32, 0, implicit $exec :: (store (s32) into %stack.0, addrspace 5)
    $vgpr2 = SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    GLOBAL_STORE_DWORD $vgpr0_vgpr1, $vgpr2, 0, 0, implicit $exec :: (store (s32), addrspace 1)
    S_ENDPGM 0
...

# CHECK-LABEL: name: fully_redundant
# CHECK: bb.1:
# CHECK-NOT: SI_SPILL_V32_RESTORE
# CHECK: bb.2:
# CHECK-NOT: SI_SPILL_V32_
# CHECK: bb.3:
# CHECK-NOT: SI_SPILL_V32_SAVE
# CHECK: SI_SPILL_V32_RESTORE

---
