    liveins: $sgpr32, $vgpr0_vgpr1, $vgpr2
    $vgpr2 = SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s32) from %stack.0, addrspace 5)
    $vgpr0 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    liveins: $sgpr32, $vgpr0_vgpr1, $vgpr2

    S_BRANCH %bb.3

