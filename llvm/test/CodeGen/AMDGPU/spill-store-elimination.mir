# CHECK: bb.1:
# CHECK: SI_SPILL_V{{32|64}}_RESTORE
# CHECK: bb.2:
# CHECK: SI_SPILL_V32_SAVE
# CHECK: bb.3:
# CHECK-NOT: SI_SPILL_V32_SAVE
# CHECK: SI_SPILL_V32_RESTORE

---
name: reload_still_used
tracksRegLiveness: true
stack:
