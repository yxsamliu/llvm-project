# RUN: llc -verify-machineinstrs -mtriple=amdgcn-amd-amdhsa -run-pass branch-relaxation %s -o - | FileCheck %s

# Generated from branch-relaxation-meta-instr.ll with:
# llc -mtriple=amdgcn-amd-amdhsa -O3 -stop-after=prologepilog
#
# Branch relaxation queries instruction sizes. CFI_INSTRUCTION is a meta
# instruction emitted by prolog/epilog insertion and has no encoded size.

---
name:            branch_relaxation_meta_instr
tracksRegLiveness: true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
  scratchRSrcReg: '$sgpr0_sgpr1_sgpr2_sgpr3'
body:             |
  ; CHECK-LABEL: name: branch_relaxation_meta_instr
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   frame-setup CFI_INSTRUCTION llvm_def_aspace_cfa $sgpr32, 0, 6
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK: bb.1:

  bb.0:
    successors: %bb.1(0x80000000)

    frame-setup CFI_INSTRUCTION llvm_def_aspace_cfa $sgpr32, 0, 6
    S_BRANCH %bb.1

  bb.1:
    S_ENDPGM 0
...
