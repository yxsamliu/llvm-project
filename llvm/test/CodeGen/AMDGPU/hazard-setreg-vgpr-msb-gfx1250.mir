# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -run-pass=amdgpu-lower-vgpr-encoding -o - %s | FileCheck %s

# Test that a V_NOP is inserted between S_SETREG_IMM32_B32 targeting MODE and
# a following S_SET_VGPR_MSB. On GFX1250, S_SET_VGPR_MSB immediately after
# S_SETREG_IMM32_B32 (MODE) is silently dropped due to a hardware hazard.

---
# Case 1: S_SETREG_IMM32_B32 targeting MODE (offset=2, size=2) piggybacks
# VGPR MSB for dst=1 (v256). The following instruction needs dst=0 (low VGPR),
# so a new S_SET_VGPR_MSB is emitted. A V_NOP must separate them.
name: setreg_mode_piggyback_then_mode_change
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: setreg_mode_piggyback_then_mode_change
    ; CHECK: S_SET_VGPR_MSB
    ; CHECK-NEXT: $vgpr256 = V_MOV_B32_e32
    ; CHECK-NEXT: S_SETREG_IMM32_B32
    ; CHECK-NEXT: V_NOP_e32
    ; CHECK-NEXT: V_NOP_e32
    ; CHECK-NEXT: S_SET_VGPR_MSB
    ; CHECK-NEXT: $vgpr0 = V_ADD_F32_e32
    $vgpr256 = V_MOV_B32_e32 undef $sgpr0, implicit $exec
    ; hwreg(MODE, 2, 2): simm16 = 1 | (2 << 6) | (1 << 11) = 0x881 = 2177
    S_SETREG_IMM32_B32 0, 2177, implicit-def $mode, implicit $mode
    $vgpr0 = V_ADD_F32_e32 undef $vgpr1, undef $vgpr2, implicit $exec, implicit $mode
    S_ENDPGM 0
...

---
# Case 2: S_SETREG_IMM32_B32 targeting MODE with size > 12, imm32[12:19]
# doesn't match VGPR MSBs. A S_SET_VGPR_MSB is inserted after setreg to
# restore the correct value. A V_NOP must separate them.
name: setreg_mode_size_gt_12_mismatch
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: setreg_mode_size_gt_12_mismatch
    ; CHECK: S_SET_VGPR_MSB
    ; CHECK-NEXT: $vgpr256 = V_MOV_B32_e32
    ; CHECK-NEXT: S_SETREG_IMM32_B32
    ; CHECK-NEXT: V_NOP_e32
    ; CHECK-NEXT: V_NOP_e32
    ; CHECK-NEXT: S_SET_VGPR_MSB
    $vgpr256 = V_MOV_B32_e32 undef $sgpr0, implicit $exec
    ; hwreg(MODE, 0, 16): simm16 = 1 | (0 << 6) | (15 << 11) = 0x7801 = 30721
    ; imm32 = 0x23ABC = 146108 (bits 12:19 = 0x23, doesn't match VGPR MSB mode)
    S_SETREG_IMM32_B32 146108, 30721, implicit-def $mode, implicit $mode
    S_ENDPGM 0
...

---
# No hazard: S_SETREG_IMM32_B32 targeting non-MODE register.
name: setreg_non_mode_no_hazard
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: setreg_non_mode_no_hazard
    ; CHECK: S_SET_VGPR_MSB
    ; CHECK-NEXT: $vgpr256 = V_MOV_B32_e32
    ; CHECK-NEXT: S_SETREG_IMM32_B32
    ; CHECK-NOT: V_NOP
    ; CHECK-NEXT: S_SET_VGPR_MSB
    ; CHECK-NEXT: $vgpr0 = V_ADD_F32_e32
    $vgpr256 = V_MOV_B32_e32 undef $sgpr0, implicit $exec
    ; hwreg(STATUS, 2, 2): simm16 = 2 | (2 << 6) | (1 << 11) = 0x882 = 2178
    S_SETREG_IMM32_B32 0, 2178, implicit-def $mode, implicit $mode
    $vgpr0 = V_ADD_F32_e32 undef $vgpr1, undef $vgpr2, implicit $exec, implicit $mode
    S_ENDPGM 0
...
