# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# Other opcodes keep normal selection, and scheduling progresses if there is no cycle-ready alternative.
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler -verify-machineinstrs -misched-prera-direction=bottomup -amdgpu-defer-unready-buffer-loads=true %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=machine-scheduler -verify-machineinstrs -misched-prera-direction=bottomup -amdgpu-defer-unready-buffer-loads=false %s -o - | FileCheck %s

---
name: other_opcode
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: other_opcode
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:sgpr_128 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF3:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF4:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF5:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF6:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[V_MUL_LO_U32_e64_:%[0-9]+]]:vgpr_32 = V_MUL_LO_U32_e64 [[DEF3]], [[DEF4]], implicit $exec
  ; CHECK-NEXT:   [[V_ADD_U32_e32_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 2, [[V_MUL_LO_U32_e64_]], implicit $exec
  ; CHECK-NEXT:   [[V_ADD_U32_e32_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 3, [[V_ADD_U32_e32_]], implicit $exec
  ; CHECK-NEXT:   [[V_ADD_U32_e32_2:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 4, [[V_ADD_U32_e32_1]], implicit $exec
  ; CHECK-NEXT:   [[BUFFER_LOAD_DWORD_OFFEN:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_DWORD_OFFEN [[DEF2]], [[DEF1]], 0, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   [[V_ADD_U32_e32_3:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 1, [[BUFFER_LOAD_DWORD_OFFEN]], implicit $exec
  ; CHECK-NEXT:   S_NOP 0, implicit [[DEF]], implicit [[DEF5]], implicit [[DEF6]], implicit [[V_ADD_U32_e32_3]], implicit [[V_ADD_U32_e32_2]], implicit [[DEF1]], implicit [[DEF2]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    %0:vreg_1024 = IMPLICIT_DEF
    %1:vreg_1024 = IMPLICIT_DEF
    %2:vreg_1024 = IMPLICIT_DEF
    %3:sgpr_128 = IMPLICIT_DEF
    %4:vgpr_32 = IMPLICIT_DEF
    %5:vgpr_32 = IMPLICIT_DEF
    %6:vgpr_32 = IMPLICIT_DEF
    S_BRANCH %bb.1

  bb.1:
    %7:vgpr_32 = BUFFER_LOAD_DWORD_OFFEN %4, %3, 0, 0, 0, 0, implicit $exec
    %8:vgpr_32 = V_MUL_LO_U32_e64 %5, %6, implicit $exec
    %9:vgpr_32 = V_ADD_U32_e32 2, %8, implicit $exec
    %10:vgpr_32 = V_ADD_U32_e32 3, %9, implicit $exec
    %11:vgpr_32 = V_ADD_U32_e32 4, %10, implicit $exec
    %12:vgpr_32 = V_ADD_U32_e32 1, %7, implicit $exec
    S_NOP 0, implicit %0, implicit %1, implicit %2, implicit %12, implicit %11, implicit %3, implicit %4
    S_ENDPGM 0
...

---
name: no_ready_alternative
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: no_ready_alternative
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:sgpr_128 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF3:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF4:%[0-9]+]]:vreg_1024 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[BUFFER_LOAD_USHORT_OFFEN:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_USHORT_OFFEN [[DEF2]], [[DEF1]], 0, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   [[BUFFER_LOAD_USHORT_OFFEN1:%[0-9]+]]:vgpr_32 = BUFFER_LOAD_USHORT_OFFEN [[DEF2]], [[DEF1]], 0, 2, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_NOP 0, implicit [[DEF]], implicit [[DEF3]], implicit [[DEF4]], implicit [[BUFFER_LOAD_USHORT_OFFEN]], implicit [[BUFFER_LOAD_USHORT_OFFEN1]], implicit [[DEF1]], implicit [[DEF2]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    %0:vreg_1024 = IMPLICIT_DEF
    %1:vreg_1024 = IMPLICIT_DEF
    %2:vreg_1024 = IMPLICIT_DEF
    %3:sgpr_128 = IMPLICIT_DEF
    %4:vgpr_32 = IMPLICIT_DEF
    S_BRANCH %bb.1

  bb.1:
