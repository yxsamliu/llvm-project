    %6:vgpr_32 = BUFFER_LOAD_USHORT_OFFEN %4, %3, 0, 2, 0, 0, implicit $exec
    S_NOP 0, implicit %0, implicit %1, implicit %2, implicit %5, implicit %6, implicit %3, implicit %4
    S_ENDPGM 0
...
