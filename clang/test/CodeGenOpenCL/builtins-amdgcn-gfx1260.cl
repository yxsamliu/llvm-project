void test_perm_pk(ushort a16, uint a32, uint2 a64, uint b32, uint c32, unsigned long c64, uint2 *out2, uint3 *out3, uint4 *out4_1, uint4 *out4_2, uint6 *out6, uint8 *out8) {
  *out2 = __builtin_amdgcn_perm_pk16_b4_u2(a16, b32);
