// Check that addrspaces are inferred on builtin ptr operands

#define __global__ __attribute__((global))
#define __shared__ __attribute__((shared))
#define __device__ __attribute__((device))
#define __exp_amd_laneshared__ __attribute__((exp_amd_laneshared))
#define __exp_amd_wavegroup_kernel(num_wavegroups, wave_size, block_x, block_y, block_z) \
    __attribute__((amdgpu_wavegroup_kernel(num_wavegroups, wave_size, block_x, block_y, block_z)))
#define __exp_amd_spatial_cluster__ \
    __attribute__((amdgpu_spatial_cluster_kernel))
#define __cluster_dims__(...) __attribute__((cluster_dims(__VA_ARGS__)))
#define HIP_INLINE __attribute__((always_inline))

__shared__ __amdgpu_semaphore0_t sema_next;
__shared__ __amdgpu_semaphore0_t sema_prev;

__exp_amd_laneshared__ int ls_next[2];
__exp_amd_laneshared__ int ls_prev[2];

