// CHECK-NEXT:    [[TMP1:%.*]] = tail call i32 @llvm.amdgcn.query.shared.rank(ptr addrspace(11) nonnull [[ARRAYIDX]])
// CHECK-NEXT:    store i32 [[TMP1]], ptr addrspace(1) [[OUT_COERCE]], align 4, !tbaa [[TBAA4]]
// CHECK-NEXT:    ret void
