__cluster_dims__(8, 1, 1)
__exp_amd_wavegroup_kernel(
        /* num_wavegroups */ 4,
        /* wave size */ 32,
        /* block_size */ 128, 1, 1)
// CHECK-LABEL: define dso_local amdgpu_kernel void @_Z33spatial_kernel_infers_zero_offsetPiPKii(
// CHECK-SAME: ptr addrspace(1) noundef readnone captures(none) [[OUT_COERCE:%.*]], ptr addrspace(1) noundef readonly captures(none) [[IN_COERCE:%.*]], i32 noundef [[SIZE:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] !reqd_work_group_size [[META8:![0-9]+]] {
// CHECK-NEXT:  [[ENTRY:.*:]]
// CHECK-NEXT:    tail call void @llvm.amdgcn.load.mcast.b32.p1(ptr addrspace(10) nonnull getelementptr inbounds nuw (i8, ptr addrspace(10) @ls_next, i32 4), ptr addrspace(1) [[IN_COERCE]], i32 0, i32 786432)
// CHECK-NEXT:    tail call void @llvm.amdgcn.load.mcast.b32.p1(ptr addrspace(10) nonnull getelementptr inbounds nuw (i8, ptr addrspace(10) @ls_prev, i32 4), ptr addrspace(1) [[IN_COERCE]], i32 0, i32 786432)
// CHECK-NEXT:    tail call void @llvm.amdgcn.spatial.cluster.send.next(i32 0, ptr addrspace(10) @ls_next, ptr addrspace(3) @sema_next, ptr addrspace(10) @ls_prev, ptr addrspace(3) @sema_prev, i32 0)
// CHECK-NEXT:    tail call void @llvm.amdgcn.spatial.cluster.send.prev(i32 0, ptr addrspace(10) @ls_prev, ptr addrspace(3) @sema_prev, ptr addrspace(10) @ls_next, ptr addrspace(3) @sema_next, i32 0)
// CHECK-NEXT:    tail call void @llvm.amdgcn.s.sema.wait(ptr addrspace(3) @sema_next)
// CHECK-NEXT:    tail call void @llvm.amdgcn.s.sema.wait(ptr addrspace(3) @sema_prev)
// CHECK-NEXT:    fence syncscope("workgroup") acquire, !mmra [[META9:![0-9]+]]
// CHECK-NEXT:    ret void
//
void spatial_kernel_infers_zero_offset(int* out, const int* in, int size) {
  // There's no addrspacecast on the vnbr since it's zero offset from ls_next/prev.
  // MCast addrspace are inferred by directly looking at its operands.
  using pLSi32 = __attribute__((address_space(10))) int *;
  using pGi32 = __attribute__((address_space(1))) int *;
  int index = 0;
  auto src_laneshared_next = (pLSi32)&ls_next[index + 1];
  auto src_laneshared_prev = (pLSi32)&ls_prev[index + 1];
  auto dst_laneshared_next = (pLSi32)&ls_next[index];
  auto dst_laneshared_prev = (pLSi32)&ls_prev[index];
  auto src_global = (pGi32) &in[0];

  constexpr unsigned int nbytes = 4;
  constexpr unsigned int num_16B = nbytes / 16;

  __builtin_amdgcn_load_mcast_b32(
      (pLSi32)(src_laneshared_next),
      (pGi32)(src_global),
      0, 3 << 18);
  __builtin_amdgcn_load_mcast_b32(
      (pLSi32)(src_laneshared_prev),
      (pGi32)(src_global),
      0, 3 << 18);

  __builtin_amdgcn_spatial_cluster_send_next(
    0, // If this was *src_laneshared_next, i.e. a load, then the mcast addrspace would be inferred.
    dst_laneshared_next, &sema_next,
    dst_laneshared_prev, &sema_prev,
    0);
  __builtin_amdgcn_spatial_cluster_send_prev(
    0,
    dst_laneshared_prev, &sema_prev,
    dst_laneshared_next, &sema_next,
    0);

  __builtin_amdgcn_s_sema_wait(&sema_next);
  __builtin_amdgcn_s_sema_wait(&sema_prev);
  __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "laneshared");
}

