// CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds nuw i8, ptr addrspace(11) [[TMP0]], i32 16
// CHECK-NEXT:    tail call void @llvm.amdgcn.dds.load.async.to.lds.b32(ptr addrspace(11) nonnull [[ARRAYIDX]], ptr addrspace(3) nonnull getelementptr inbounds nuw (i8, ptr addrspace(3) @lds_buffer, i32 32), i32 0, i32 0)
