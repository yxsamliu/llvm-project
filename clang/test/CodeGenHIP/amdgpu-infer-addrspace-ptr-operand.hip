}

// Test load_mcast with laneshared
__global__
__exp_amd_spatial_cluster__
__cluster_dims__(8, 1, 1)
__exp_amd_wavegroup_kernel(4, 32, 128, 1, 1)
// CHECK-LABEL: define dso_local amdgpu_kernel void @_Z38load_mcast_infers_laneshared_addrspacePiPKi(
// CHECK-SAME: ptr addrspace(1) noundef readnone captures(none) [[OUT_COERCE:%.*]], ptr addrspace(1) noundef readonly captures(none) [[IN_COERCE:%.*]]) local_unnamed_addr #[[ATTR8:[0-9]+]] !reqd_work_group_size [[META8]] {
// CHECK-NEXT:  [[ENTRY:.*:]]
// CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds nuw i8, ptr addrspace(1) [[IN_COERCE]], i64 16
// CHECK-NEXT:    tail call void @llvm.amdgcn.load.mcast.b32.p1(ptr addrspace(10) nonnull getelementptr inbounds nuw (i8, ptr addrspace(10) @ls_next, i32 4), ptr addrspace(1) nonnull [[ARRAYIDX]], i32 0, i32 3)
// CHECK-NEXT:    ret void
//
void load_mcast_infers_laneshared_addrspace(int* out, const int* in)
{
    using pLSi32 = __attribute__((address_space(10))) int *;
    using pGlobal = __attribute__((address_space(1))) int *;

    pLSi32 ls_dest = (pLSi32)&ls_next[1];
    pGlobal global_src = (pGlobal)&in[4];

    __builtin_amdgcn_load_mcast_b32(
        ls_dest,
        global_src,
        0,        // cachepolicy
        0x3);     // workgroup and SIMD broadcast mask
}

